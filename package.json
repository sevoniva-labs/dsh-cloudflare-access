{
  "name": "@sevoniva/dsh-cloudflare-access",
  "version": "0.1.0-alpha.9",
  "description": "Cloudflare Zero Trust access for DeepSeek Harness (DSH). Access 认证、Tunnel 与 DNS 配置，无需公网 IP。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cloudflare",
    "cloudflare-access",
    "cloudflare-tunnel",
    "cloudflare-zero-trust",
    "remote-access",
    "self-hosted",
    "authentication"
  ],
  "homepage": "https://github.com/sevoniva-labs/dsh-cloudflare-access#readme",
  "bugs": {
    "url": "https://github.com/sevoniva-labs/dsh-cloudflare-access/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sevoniva-labs/dsh-cloudflare-access.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node --experimental-transform-types scripts/test-session-browser.mjs",
    "test:browser:assets": "node --experimental-transform-types scripts/test-assets-browser.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.6-alpha.2",
    "jose": "6.2.2",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-frontend-static": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
